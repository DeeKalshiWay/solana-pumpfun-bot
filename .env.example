# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real keys.

# REQUIRED — your Solana wallet's base58 private key.
# Phantom/Solflare → Settings → Show Private Key → paste here.
SOLANA_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# RECOMMENDED — Helius free RPC (https://dev.helius.xyz/dashboard/app)
# Without this you'll fall back to public mainnet-beta which is slower
# and rate-limited.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY_HERE
HELIUS_API_KEY=YOUR_HELIUS_KEY_HERE

# OPTIONAL — Twitter v2 API key (Basic tier is fine).
# Enables the influencer-mention scoring bonus.
# Without this, influencer monitor is a no-op.
TWITTER_BEARER_TOKEN=

# OPTIONAL — Telegram (https://my.telegram.org/auth) for channel monitoring.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# OPTIONAL — Birdeye API key for security/holder data
# Free tier at https://birdeye.so/
BIRDEYE_API_KEY=

# OPTIONAL — HTTP Basic Auth for the web dashboard (port 8765).
# Strongly recommended if the dashboard is reachable beyond 127.0.0.1, since
# its POST endpoints can emergency-stop the bot and force-sell positions.
# Set BOTH to enable auth; unset = no auth (legacy behaviour).
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASS=


# ────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Strategy parameter overrides
# ────────────────────────────────────────────────────────────────────────────
# Every variable below is OPTIONAL. config.py ships with conservative
# starter defaults so the bot runs safely out of the box. Uncomment and
# set any of these to override. The bot operator's own tuned values
# stay in their local .env (gitignored), not here.
#
# Sizing:
# MAX_SOL_PER_TRADE=0.05           # base trade size cap, SOL
# MAX_POSITION_PCT=0.05            # cap as % of wallet (0.05 = 5%)
# MAX_TOTAL_EXPOSURE_SOL=0.50      # total simultaneous exposure
# MAX_OPEN_POSITIONS=3
#
# Adaptive Kelly-lite:
# ADAPTIVE_HOT_WR=0.55             # WR threshold to scale up
# ADAPTIVE_HOT_MULT=1.25           # multiplier on hot streaks
# ADAPTIVE_COLD_WR=0.30            # WR threshold to scale down
# ADAPTIVE_COLD_MULT=0.50
# ADAPTIVE_HARD_CAP_MULT=1.50      # absolute cap regardless of streak
#
# Take-profit ladder (JSON list of {gain_pct, sell_pct}):
# TAKE_PROFIT_LEVELS=[{"gain_pct":50,"sell_pct":25},{"gain_pct":100,"sell_pct":25},{"gain_pct":200,"sell_pct":25}]
#
# Trailing stops + stops:
# TRAILING_STOP_MIN_PROFIT=20      # don't trail until peak >= +20%
# TRAILING_STOP_PCT=15             # tight trail %, early winners
# TRAILING_STOP_MOONSHOT_PCT=25    # wider trail % once in moonshot mode
# TRAILING_STOP_MOONSHOT_TRIGGER=100  # peak % that flips to moonshot trail
# STOP_LOSS_PCT=15                 # hard stop loss %
# EMERGENCY_STOP_DRAWDOWN_PCT=25   # halt-all if lifetime DD exceeds this
# TIME_EXIT_MINUTES=5              # force-close idle positions after N min
# NO_MOVEMENT_EXIT_SECONDS=90      # exit if flat for this long
# NO_MOVEMENT_BAND_PCT=3.0         # ± band that counts as "flat"
#
# Circuit breakers:
# LOSS_STREAK_LIMIT=5              # consecutive losses before pausing
# LOSS_STREAK_PAUSE_MIN=15         # pause duration in minutes
# DAILY_LOSS_LIMIT_PCT=20          # halt for the day if losses >= this %
# DAILY_PROFIT_LOCK_PCT=9999       # halt for the day if profits >= this %
#
# Momentum stall exit:
# MOMENTUM_STALL_PCT_BAND=5.0      # ± band considered "stalled"
# MOMENTUM_STALL_WINDOW_SEC=60     # seconds inside band that triggers exit
# MOMENTUM_STALL_MIN_PROFIT=5.0    # only stall-exit above this PnL %
#
# Scoring:
# MIN_BUY_SCORE=60                 # signal score floor for entry
# MIN_BONDING_CURVE_PCT=30.0       # ignore tokens below this curve %
# MAX_BONDING_CURVE_PCT=80.0       # ignore tokens within 20% of migration
# BUY_COOLDOWN_SECONDS=15          # wait this long after detection before buy
